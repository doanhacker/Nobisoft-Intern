generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum IndexStatus {
  PENDING
  SUCCESS
  FAILED
  ERROR
}

enum BatchStatus {
  UPLOADING
  PROCESSING
  COMPLETED
}

model User {
  id         String    @id @default(uuid()) @db.Uuid
  email      String    @unique @db.VarChar(50)
  password   String    @db.VarChar(255)
  name       String    @db.VarChar(50)
  nameSearch String    @db.VarChar(50)
  role       Role      @default(USER)
  createdAt  DateTime  @default(now()) @db.Timestamptz()
  updatedAt  DateTime  @updatedAt @db.Timestamptz()
  deletedAt  DateTime? @db.Timestamptz()

  searchHistories SearchHistory[]
  batches         BatchIndex[]

  @@index([nameSearch])
  @@map("users")
}

model BatchIndex {
  id              String      @id @default(uuid()) @db.Uuid
  uploadedBy      String?     @db.Uuid
  totalImages     Int         @default(0)
  successCount    Int         @default(0)
  failedCount     Int         @default(0)
  status          BatchStatus @default(UPLOADING)
  totalDurationMs Int?
  createdAt       DateTime    @default(now()) @db.Timestamptz()
  updatedAt       DateTime    @updatedAt @db.Timestamptz()

  uploadedByUser User?        @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)
  imageIndexes   ImageIndex[]

  @@index([uploadedBy])
  @@map("batch_index")
}

model Image {
  id         String   @id @default(uuid()) @db.Uuid
  path       String   @db.VarChar(500)
  width      Int?
  height     Int?
  fileSize   Int?
  fileFormat String?  @db.VarChar(20)
  createdAt  DateTime @default(now()) @db.Timestamptz()
  deletedAt  DateTime? @db.Timestamptz()

  imageIndex      ImageIndex?
  searchHistories SearchHistory[]
  searchClicks    SearchClick[]

  @@index([deletedAt])
  @@map("images")
}

model ImageIndex {
  id       String      @id @default(uuid()) @db.Uuid
  imageId  String      @unique @db.Uuid
  batchId  String      @db.Uuid
  status   IndexStatus @default(PENDING)
  indexedAt DateTime?  @db.Timestamptz()

  image    Image      @relation(fields: [imageId], references: [id], onDelete: Cascade)
  batch    BatchIndex @relation(fields: [batchId], references: [id], onDelete: Cascade)
  ocrLines ImageOcr[]

  @@index([batchId])
  @@map("image_index")
}

model ImageOcr {
  id              String @id @default(uuid()) @db.Uuid
  imageIndexId    String @db.Uuid
  rawText         String @db.Text
  normalizedText  String @db.Text
  confidenceScore Float
  boundingBoxes   Json?  @db.JsonB

  imageIndex ImageIndex @relation(fields: [imageIndexId], references: [id], onDelete: Cascade)

  @@index([imageIndexId])
  @@index([normalizedText])
  @@map("image_ocr")
}

enum SearchType {
  IMAGE_ONLY
  TEXT_SEMANTIC
  TEXT_OCR
  TEXT_PROMPT
}

model SearchHistory {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String?    @db.Uuid
  searchType   SearchType
  queryImageId String?    @db.Uuid
  queryText    String?    @db.Text
  createdAt    DateTime   @default(now()) @db.Timestamptz()

  user       User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  queryImage Image?        @relation(fields: [queryImageId], references: [id], onDelete: SetNull)
  clicks     SearchClick[]

  @@index([userId])
  @@index([searchType])
  @@index([createdAt])
  @@map("search_history")
}

model SearchClick {
  id              String   @id @default(uuid()) @db.Uuid
  searchHistoryId String   @db.Uuid
  clickedImageId  String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz()

  searchHistory SearchHistory @relation(fields: [searchHistoryId], references: [id], onDelete: Cascade)
  clickedImage  Image         @relation(fields: [clickedImageId], references: [id], onDelete: Cascade)

  @@index([searchHistoryId])
  @@index([clickedImageId])
  @@map("search_clicks")
}
