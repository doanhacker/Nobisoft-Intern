generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

model User {
  id         String    @id @default(uuid()) @db.Uuid
  email      String    @unique @db.VarChar(50)
  password   String    @db.VarChar(255)
  name       String    @db.VarChar(50)
  nameSearch String    @db.VarChar(50)
  role       Role      @default(USER)
  createdAt  DateTime  @default(now()) @db.Timestamptz()
  updatedAt  DateTime  @updatedAt @db.Timestamptz()
  deletedAt  DateTime? @db.Timestamptz()

  searchHistories SearchHistory[]

  @@index([nameSearch])
  @@map("users")
}

model Image {
  id         String   @id @default(uuid()) @db.Uuid
  path       String   @db.VarChar(500)
  width      Int
  height     Int
  fileSize   Int
  fileFormat String   @db.VarChar(20)
  createdAt  DateTime @default(now()) @db.Timestamptz()

  imageIndex      ImageIndex?
  searchHistories SearchHistory[]
  searchClicks    SearchClick[]

  @@map("images")
}

model ImageIndex {
  id                String   @id @default(uuid()) @db.Uuid
  imageId           String   @unique @db.Uuid
  processDurationMs Int?
  createdAt         DateTime @default(now()) @db.Timestamptz()

  image    Image      @relation(fields: [imageId], references: [id], onDelete: Cascade)
  ocrLines ImageOcr[]

  @@map("image_index")
}

model ImageOcr {
  id              String @id @default(uuid()) @db.Uuid
  imageIndexId    String @db.Uuid
  rawText         String @db.Text
  normalizedText  String @db.Text
  confidenceScore Float
  boundingBoxes   Json?  @db.JsonB

  imageIndex ImageIndex @relation(fields: [imageIndexId], references: [id], onDelete: Cascade)

  @@index([imageIndexId])
  @@map("image_ocr")
}

enum SearchType {
  IMAGE_ONLY
  TEXT_SEMANTIC
  TEXT_OCR
}

model SearchHistory {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String?    @db.Uuid
  searchType   SearchType
  queryImageId String?    @db.Uuid
  queryText    String?    @db.Text
  createdAt    DateTime   @default(now()) @db.Timestamptz()

  user       User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  queryImage Image?        @relation(fields: [queryImageId], references: [id], onDelete: SetNull)
  clicks     SearchClick[]

  @@index([userId])
  @@index([searchType])
  @@index([createdAt])
  @@map("search_history")
}

model SearchClick {
  id              String   @id @default(uuid()) @db.Uuid
  searchHistoryId String   @db.Uuid
  clickedImageId  String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz()

  searchHistory SearchHistory @relation(fields: [searchHistoryId], references: [id], onDelete: Cascade)
  clickedImage  Image         @relation(fields: [clickedImageId], references: [id], onDelete: Cascade)

  @@index([searchHistoryId])
  @@index([clickedImageId])
  @@map("search_clicks")
}
