generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

model User {
  id         String    @id @default(uuid()) @db.Uuid
  email      String    @unique @db.VarChar(50)
  password   String    @db.VarChar(255)
  name       String    @db.VarChar(50)
  nameSearch String    @db.VarChar(50) // Tên không dấu, lowercase — dùng cho tìm kiếm
  role       Role      @default(USER)
  createdAt  DateTime  @default(now()) @db.Timestamptz()
  updatedAt  DateTime  @updatedAt @db.Timestamptz()
  deletedAt  DateTime? @db.Timestamptz()

  searchHistories SearchHistory[]
  apiTrackings    ApiTracking[]

  @@index([nameSearch])
  @@map("users")
}

// Bảng lưu thông tin chi tiết của ảnh
model ImageMetadata {
  id         String   @id @default(uuid()) @db.Uuid
  path       String   @db.VarChar(500)
  width      Int
  height     Int
  fileSize   Int
  fileFormat String   @db.VarChar(20)
  createdAt  DateTime @default(now()) @db.Timestamptz()
  updatedAt  DateTime @updatedAt @db.Timestamptz()

  ocrResults      ImageOcr[]
  searchHistories SearchHistory[]

  @@map("image_metadata")
}

// Bảng lưu văn bản trích xuất (OCR) từ ảnh
model ImageOcr {
  id              String @id @default(uuid()) @db.Uuid
  imageId         String @db.Uuid
  rawText         String @db.Text
  normalizedText  String @db.Text
  confidenceScore Float
  boundingBoxes   Json?  @db.JsonB

  image ImageMetadata @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@index([imageId])
  @@map("image_ocr")
}

enum SearchType {
  IMAGE_ONLY
  TEXT_SEMANTIC
  TEXT_OCR
}

// Lịch sử tìm kiếm & tương tác người dùng
model SearchHistory {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String?    @db.Uuid
  searchType     SearchType
  queryImagePath String?    @db.VarChar(500)
  queryText      String?    @db.Text
  clickedImageId String?    @db.Uuid
  createdAt      DateTime   @default(now()) @db.Timestamptz()
  updatedAt      DateTime   @updatedAt @db.Timestamptz()

  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  clickedImage ImageMetadata? @relation(fields: [clickedImageId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([searchType])
  @@index([createdAt])
  @@map("search_history")
}

// Bảng theo dõi hiệu suất hệ thống
model ApiTracking {
  id             String   @id @default(uuid()) @db.Uuid
  method         String   @db.VarChar(10)
  path           String   @db.VarChar(500)
  statusCode     Int
  responseTimeMs Int
  ipAddress      String?  @db.VarChar(45)
  userAgent      String?  @db.VarChar(500)
  userId         String?  @db.Uuid
  requestBody    Json?    @db.JsonB
  responseBody   Json?    @db.JsonB
  errorMessage   String?  @db.Text
  createdAt      DateTime @default(now()) @db.Timestamptz()

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([statusCode])
  @@index([createdAt])
  @@index([userId])
  @@index([ipAddress])
  @@map("api_tracking")
}
