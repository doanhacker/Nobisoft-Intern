# Server
PORT=8000

# Database for local backend development
DATABASE_URL=postgresql://visual_search:change_me@localhost:5432/visual_search?schema=public

# JWT
JWT_ACCESS_SECRET=change_me_to_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=24h

# Seed admin account
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=ChangeMe@123

# Services for local backend development
AI_SERVICE_URL=http://localhost:9000
QDRANT_URL=http://localhost:6333
SEARCH_MIN_SCORE_IMAGE=0.3
SEARCH_MIN_SCORE_SEMANTIC=0.1
RECOMMENDATION_CLICK_LIMIT=30
STORAGE_DIR=./storage

# Automatically permanently delete images after they remain in trash for this period
TRASH_AUTO_CLEANUP_ENABLED=true
TRASH_RETENTION_DAYS=30
TRASH_CLEANUP_INTERVAL_HOURS=24

# ─── CORS (local dev) ───
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:8000"

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Ollama (Prompt Translation)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# Redis
REDIS_URL=redis://localhost:6379
