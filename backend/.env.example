# Server
PORT=8000

# Database for local backend development
DATABASE_URL=postgresql://visual_search:change_me@localhost:5432/visual_search?schema=public

# JWT
JWT_ACCESS_SECRET=change_me_to_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=24h

# Seed admin account
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=ChangeMe@123

# Services for local backend development
AI_SERVICE_URL=http://localhost:9000
QDRANT_URL=http://localhost:6333
SEARCH_MIN_SCORE=0.5
SEARCH_MAX_RESULTS=2000
STORAGE_DIR=./storage

# ─── CORS (local dev) ───
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:8000"
