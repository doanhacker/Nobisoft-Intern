# Server
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000

# Database PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=VisualSearchEngine
DATABASE_URL=postgresql://postgres:postgres@database:5432/VisualSearchEngine?schema=public

# JWT
JWT_ACCESS_SECRET=change_me_to_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=24h

# Seed admin account
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=ChangeMe@123

# Services for Docker Compose
AI_SERVICE_URL=http://ai-service:9000
QDRANT_URL=http://qdrant:6333
SEARCH_MIN_SCORE_IMAGE=0.3
SEARCH_MIN_SCORE_SEMANTIC=0.1
SEARCH_MAX_RESULTS=2000
STORAGE_DIR=./storage

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
