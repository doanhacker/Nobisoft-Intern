# ─── Server ───
BACKEND_PORT=8000

# Domain for Nginx + SSL (production only)
DOMAIN=your-domain.com
CERTBOT_EMAIL=your-email@example.com

FRONTEND_URL=http://localhost
BACKEND_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000/api

# ─── Database PostgreSQL ───
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=VisualSearchEngine
DATABASE_URL=postgresql://postgres:postgres@database:5432/VisualSearchEngine?schema=public

# ─── JWT ───
JWT_ACCESS_SECRET=change_me_to_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=24h

# ─── Seed admin account ───
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=ChangeMe@123

# ─── Services for Docker Compose ───
AI_SERVICE_URL=http://ai-service:9000
QDRANT_URL=http://qdrant:6333
SEARCH_MIN_SCORE_IMAGE=0.3
SEARCH_MIN_SCORE_SEMANTIC=0.1
SEARCH_MAX_RESULTS=2000
STORAGE_DIR=./storage

# ─── Trash auto-cleanup ───
TRASH_AUTO_CLEANUP_ENABLED=true
TRASH_RETENTION_DAYS=30
TRASH_CLEANUP_INTERVAL_HOURS=24

# ─── RabbitMQ ───
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

RECOMMENDATION_CLICK_LIMIT=30

# ─── Ollama (Prompt Translation) ───
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=gemma2:2b